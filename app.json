{
  "expo": {
    "name": "Staff Arts",
    "slug": "staffartsv2",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo-light.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qupda.staffarts2",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qupda.staffarts2",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-light.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/logo-light.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "4531ac65-ee19-4bbf-a8fd-a08602904f3d"
      }
    }
  }
}
