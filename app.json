{
  "expo": {
    "name": "Staff Arts",
    "slug": "staffartsv2",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/logo-light.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qupda.staffarts2",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qupda.staffarts2",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-light.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/logo-light.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Staff Arts needs access to your photo library so you can select images of your artwork to upload and list for sale, and to set your profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4531ac65-ee19-4bbf-a8fd-a08602904f3d"
      }
    }
  }
}